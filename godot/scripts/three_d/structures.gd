extends Node3D
## Buildings, compound walls, vehicles and props. Footprints come from mission obstacles.
## Built once by world.gd: set `sim`, add to the tree, then call build().
##
## Everything is generated at load time as merged ArrayMeshes (one surface per material) through the mesh kit in
## structures_kit.gd; textures live in res://assets/tex/structures (see tools/gen_structures_textures.py).
const Kit = preload("res://scripts/three_d/structures_kit.gd")
const Props = preload("res://scripts/three_d/structures_props.gd")
const Buildings = preload("res://scripts/three_d/structures_buildings.gd")
const Site = preload("res://scripts/three_d/structures_site.gd")
const Truck = preload("res://scripts/three_d/structures_truck.gd")
const Rules = preload("res://scripts/three_d/structures_rules.gd")

var sim: RefCounted
var materials: Dictionary = {}
var rng := RandomNumberGenerator.new()
## Hinged cell gate; world.gd rotates gate.rotation.y to -PI/2 when the door opens.
var gate: Node3D
## One entry per mission building: {"node": Node3D, "roof": Node3D, "id": String}
var buildings: Array[Dictionary] = []
## Triangles generated by build() (for profiling).
var triangle_total: int = 0

## Props that follow the rules (kept in step with the simulation by update(), also after a checkpoint restore).
## The cuttable span of the wire: one of the two is visible.
var fence_whole: MeshInstance3D
var fence_cut: MeshInstance3D
## The generator's changing parts: hood shut and lead plugged in / hood open and lead pulled.
var generator_running: Node3D
var generator_dead: Node3D
## Leaf of the barracks' east door; swings open while reinforcements turn out and stays open while they are about.
var barracks_door: Node3D
var door_open_angle: float = 0.0
## Lit glass and halo of the alarm beacon on the aerial mast (shown in flashes while an alarm is on).
var alarm_lamp: Node3D
## Middle of the generator set and of the barracks doorway on the ground (world space), for markers and effects.
var generator_point := Vector3(26.25, 0, 4.66)
var door_point := Vector3(16.6, 0, 7.25)
## Tripwire props: armed ones by trap id, sprung ones left where they went off.
var trap_props: Dictionary = {}
var sprung_props: Array[Node3D] = []

var _props: Props
var _rules: Rules
var _boat: Node3D
var _clock: float = 0.0
var _last_time: float = 0.0
var _trap_yaw: Dictionary = {}
var _trap_pool: Array[Node3D] = []
var _trap_mesh: Mesh
var _sprung_mesh: Mesh
var _puffs: Array[MeshInstance3D] = []
var _puff_from := Vector3.ZERO
var _lamp_halo: MeshInstance3D
var _door_closed := Basis.IDENTITY
var _door_sign: float = 1.0
const DOOR_OPEN := 2.5
const SPRUNG_MAX := 3
## Boat mooring (bow toward -Z); its waterline sits a little above the water plane (Y = -0.19) so the sole stays dry.
const BOAT_AT := Vector3(3.98, -0.11, 22.05)

func build() -> void:
	rng.seed = 19431005
	materials = Kit.make_materials()
	_props = Props.new(19431006)
	_rules = Rules.new(_props, 19431010)
	var builder := Buildings.new(_props, 19431007)
	builder.sign_cells = _baked_signs()
	var site := Site.new(_props, 19431008)
	var truck := Truck.new(_props, 19431009)
	var solid := Kit.new()      # shadow-casting props and walls, world space
	var flat := Kit.new()       # ground decals and thin wires: no shadows
	var walls: Array[Rect2] = []
	var crate_index := 0
	var radio_at := Vector3(26, 0, 7)
	var radio_dims := Vector3(6, 0, 4)
	for obstacle: Dictionary in sim.data.obstacles:
		var r: Rect2 = sim.rect_of(obstacle)
		var at := Vector3(r.get_center().x / 32.0, 0, r.get_center().y / 32.0)
		var dims := Vector3(r.size.x / 32.0, 0, r.size.y / 32.0)
		match str(obstacle.kind):
			"building":
				_building(builder, flat, at, dims, str(obstacle.id), str(obstacle.get("label", "")))
				if str(obstacle.id) == "radio":
					radio_at = at
					radio_dims = dims
			"wall": walls.append(Rect2(r.position / 32.0, r.size / 32.0))
			"crates":
				site.crate_stack(solid, flat, at, crate_index)
				crate_index += 1
			"sandbags": site.sandbag_post(solid, flat, at, 0.0)
			# the truck is parked nose toward the shore along the obstacle's long axis
			"truck": truck.build(solid, flat, at, PI if dims.x >= dims.z else PI * 0.5)
	var d: Dictionary = sim.data.door
	var door_rect := Rect2(float(d.x) / 32.0, float(d.y) / 32.0, float(d.w) / 32.0, float(d.h) / 32.0)
	site.compound(solid, flat, flat, walls, door_rect)
	if not walls.is_empty():
		var bounds: Rect2 = walls[0]
		for w: Rect2 in walls:
			bounds = bounds.merge(w)
		site.yard(solid, flat, bounds.grow(-1.0), door_rect)
		# fuel drums stacked against the outside of the north wall
		site.drum_row(solid, flat, Vector3(bounds.position.x + 1.7, 0, bounds.position.y - 0.32), Vector3.RIGHT, 1)
	# drums by the barracks' east wall
	site.drum_row(solid, flat, Vector3(16.83, 0, 8.3), Vector3.BACK, 0)
	# Hinged cell gate (its own node: world.gd swings it). Geometry runs along local +X from the hinge.
	gate = Node3D.new()
	gate.name = "CellGate"
	gate.position = Vector3(door_rect.position.x, 0, door_rect.position.y + 0.5)
	add_child(gate)
	var gate_kit := Kit.new()
	site.gate(gate_kit, door_rect.size.x)
	_commit(gate_kit, gate, "GateLeaf", true)
	# perimeter fence, watchtower, telegraph line with the aerial and a spur to the tower
	_fence(site, solid, flat)
	var hook := site.watchtower(solid, flat, Vector3(38.5, 0, 3.5))
	site.pole_line(solid, flat, -1.7, [3.5, 13.0, 22.5, 32.0, 41.5], radio_at + builder.mast_top(radio_dims.x), hook)
	# landing stage and boat
	var bollard := site.dock(solid, flat, 4.8, 6.8, 22.0, 1.2)
	# The boat is its own node so update() can let it ride the swell a little.
	_boat = Node3D.new()
	_boat.name = "Boat"
	_boat.position = BOAT_AT
	_boat.rotation.y = 0.06
	add_child(_boat)
	var boat_kit := Kit.new()
	var ring := _boat.transform * site.boat(boat_kit, Vector3.ZERO, 0.0)
	_commit(boat_kit, _boat, "Hull", true)
	_props.wire(solid, bollard, ring, 0.14, 0.016, Color(0.8, 0.74, 0.6), 8)
	_commit(solid, self, "SiteProps", true)
	_commit(flat, self, "SiteFlat", false)
	_build_traps()
	_sync_rules(1.0)

## The perimeter fence runs along the rules' fence barriers; the cuttable span is left out of the run and built
## twice, whole and cut, as nodes of its own.
func _fence(site: Site, solid: Kit, flat: Kit) -> void:
	var x0 := INF
	var x1 := -INF
	var z := 2.7
	var cut_x := -1.0
	for barrier: Dictionary in sim.data.get("barriers", []):
		if str(barrier.get("kind", "")) != "fence": continue
		var r: Rect2 = sim.rect_of(barrier)
		x0 = minf(x0, r.position.x / 32.0)
		x1 = maxf(x1, r.end.x / 32.0)
		z = r.get_center().y / 32.0
		if bool(barrier.get("cuttable", false)): cut_x = r.get_center().x / 32.0
	if x0 > x1:
		x0 = 8.0
		x1 = 37.0
	var spans := maxi(1, int(round((x1 - x0) / 2.417)))
	var skip := int(floor((cut_x - x0) / ((x1 - x0) / float(spans)))) if cut_x >= x0 else -1
	var span: Array[Vector3] = site.fence(solid, flat, x0, x1, z, spans, skip)
	if span.size() < 5:
		return
	var whole := Kit.new()
	_rules.span_whole(whole, span[0], span[1], span[2], span[3], span[4].x)
	fence_whole = _commit(whole, self, "FenceSpanWhole", false)
	var cut := Kit.new()
	_rules.span_cut(cut, span[0], span[1], span[2], span[3], span[4].x)
	fence_cut = _commit(cut, self, "FenceSpanCut", false)

## The generator against the radio post's north wall, where the rules put the sabotage spot (data.radio).
func _generator(builder: Buildings, node: Node3D, dims: Vector3) -> void:
	var wall := Buildings.face("N", dims.x, dims.z)
	var cx := Buildings.GENERATOR_X
	var mast := wall.affine_inverse() * builder.mast_foot(dims.x)
	var base := Kit.new()
	base.push(wall)
	var feed: Array[Vector3] = [Vector3(dims.x - 0.1, 2.2, 0.04), Vector3(dims.x + 0.07, 2.2, 0.0), Vector3(mast.x + 0.06, 2.2, mast.z)]
	var points := _rules.generator_base(base, cx, feed)
	base.pop()
	_commit(base, node, "Generator", true)
	for running: bool in [true, false]:
		var kit := Kit.new()
		kit.push(wall)
		_rules.generator_state(kit, cx, running, points)
		if running: _rules.lamp_glass(kit, points.lamp, 0.035, Color(0.72, 1.0, 0.45))
		kit.pop()
		var part := _commit(kit, node, "GeneratorRunning" if running else "GeneratorDead", true)
		if running: generator_running = part
		else: generator_dead = part
	generator_point = node.transform * (wall * Vector3(cx, 0.0, 0.34))
	# a few puffs of exhaust above the stack while it runs
	_puff_from = wall * (points.exhaust as Vector3)
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE
	for i: int in range(3):
		var puff := MeshInstance3D.new()
		puff.name = "Exhaust%d" % i
		puff.mesh = quad
		puff.material_override = _sprite_material(Color(0.8, 0.8, 0.77, 0.0), false)
		puff.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		puff.set_meta("no_batch", true)
		generator_running.add_child(puff)
		_puffs.append(puff)

## Alarm horn and beacon clamped to the aerial mast of the radio post.
func _alarm(builder: Buildings, node: Node3D, top: Kit, dims: Vector3) -> void:
	var at := builder.mast_foot(dims.x) + Vector3(0, 3.9, 0.05)
	var glass := _rules.alarm_horn(top, at)
	_rules.lamp_glass(top, glass, 0.055, Color(0.3, 0.07, 0.05))
	alarm_lamp = Node3D.new()
	alarm_lamp.name = "AlarmLamp"
	alarm_lamp.visible = false
	node.add_child(alarm_lamp)
	var lit := Kit.new()
	_rules.lamp_glass(lit, glass, 0.06, Color(1.0, 0.36, 0.22))
	_commit(lit, alarm_lamp, "Glass", false)
	_lamp_halo = MeshInstance3D.new()
	_lamp_halo.name = "Halo"
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE
	_lamp_halo.mesh = quad
	_lamp_halo.material_override = _sprite_material(Color(1.0, 0.3, 0.16, 0.85), true)
	_lamp_halo.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_lamp_halo.position = glass
	_lamp_halo.set_meta("no_batch", true)
	alarm_lamp.add_child(_lamp_halo)

## Soft round camera-facing sprite (exhaust puffs, the beacon's halo).
func _sprite_material(col: Color, additive: bool) -> StandardMaterial3D:
	var gradient := Gradient.new()
	gradient.set_color(0, Color.WHITE)
	gradient.set_color(1, Color(1, 1, 1, 0))
	var texture := GradientTexture2D.new()
	texture.gradient = gradient
	texture.fill = GradientTexture2D.FILL_RADIAL
	texture.fill_from = Vector2(0.5, 0.5)
	texture.fill_to = Vector2(1.0, 0.5)
	texture.width = 64
	texture.height = 64
	var m := StandardMaterial3D.new()
	m.albedo_texture = texture
	m.albedo_color = col
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD if additive else BaseMaterial3D.BLEND_MODE_MIX
	m.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	m.billboard_keep_scale = true
	m.render_priority = 6          # after the world's ground overlays (sight cones, ink, markers: 1..5)
	return m

func _door_leaf(node: Node3D, spec: Dictionary) -> void:
	barracks_door = Node3D.new()
	barracks_door.name = "DoorLeaf"
	var along: Vector3 = spec.along
	var out: Vector3 = spec.out
	_door_closed = Basis(along, Vector3.UP, along.cross(Vector3.UP))
	_door_sign = 1.0 if along.rotated(Vector3.UP, PI * 0.5).dot(out) > 0.0 else -1.0
	barracks_door.transform = Transform3D(_door_closed, spec.hinge)
	door_point = node.transform * ((spec.hinge as Vector3) + along * float(spec.w) * 0.5 + out * 0.15)
	door_point.y = 0.0
	node.add_child(barracks_door)
	var leaf := Kit.new()
	_rules.door_leaf(leaf, float(spec.w), float(spec.h), str(spec.cell))
	_commit(leaf, barracks_door, "Leaf", true)

# ---------------------------------------------------------------------------------------------------------------
# Tripwires
# ---------------------------------------------------------------------------------------------------------------
func _build_traps() -> void:
	var armed := Kit.new()
	_rules.tripwire(armed, false)
	var template := _commit(armed, self, "TripwireTemplate", true)
	_trap_mesh = template.mesh
	template.free()
	var sprung := Kit.new()
	_rules.tripwire(sprung, true)
	template = _commit(sprung, self, "TripwireTemplate", true)
	_sprung_mesh = template.mesh
	template.free()
	# A fixed pool: the kit holds one wire, a restore can bring it back; nothing is created while playing.
	for i: int in range(2 + SPRUNG_MAX):
		var prop := MeshInstance3D.new()
		prop.name = "Tripwire%d" % i
		prop.visible = false
		add_child(prop)
		_trap_pool.append(prop)

## Facing of a laid tripwire's wire (rotation.y of its prop): across the way the man who set it was looking.
func trap_yaw(id: String) -> float:
	return float(_trap_yaw.get(id, 0.6))

func _sync_traps() -> void:
	var present: Dictionary = {}
	for trap: Dictionary in sim.traps:
		var id: String = str(trap.id)
		present[id] = true
		var prop: Node3D = trap_props.get(id)
		if prop == null:
			if _trap_pool.is_empty(): continue
			prop = _trap_pool.pop_back()
			(prop as MeshInstance3D).mesh = _trap_mesh
			trap_props[id] = prop
		prop.position = Vector3(float(trap.x) / 32.0, 0.0, float(trap.y) / 32.0)
		prop.rotation.y = trap_yaw(id)
		prop.visible = true
	for id: String in trap_props.keys():
		if present.has(id): continue
		var prop: Node3D = trap_props[id]
		prop.visible = false
		_trap_pool.append(prop)
		trap_props.erase(id)

func _clear_sprung() -> void:
	for prop: Node3D in sprung_props:
		prop.visible = false
		_trap_pool.append(prop)
	sprung_props.clear()

## World.gd passes every simulation event on: the tripwire remembers how it was laid and where it went off.
func on_sim_event(event: Dictionary) -> void:
	match str(event.get("type", "")):
		"trap_set":
			var by: Dictionary = sim.unit_by_id(str(event.get("by", "")))
			if not by.is_empty(): _trap_yaw[str(event.trap)] = -(float(by.angle) + PI * 0.5)
		"trap_sprung":
			if sprung_props.size() >= SPRUNG_MAX or _trap_pool.is_empty(): return
			var prop: MeshInstance3D = _trap_pool.pop_back()
			prop.mesh = _sprung_mesh
			prop.position = Vector3(float(event.x) / 32.0, 0.0, float(event.y) / 32.0)
			prop.rotation.y = trap_yaw(str(event.get("trap", "")))
			prop.visible = true
			sprung_props.append(prop)
		"checkpoint":
			if str(event.get("action", "")) == "load": _clear_sprung()

## Brings every rules prop in line with the simulation. Reads state only, so a checkpoint restore, a restart or
## a missed event cannot leave a prop in the wrong state.
func _sync_rules(dt: float) -> void:
	if float(sim.time) < _last_time - 0.0001: _clear_sprung()      # the clock went back: restart or restore
	_last_time = float(sim.time)
	if fence_whole != null:
		fence_whole.visible = not bool(sim.fence_cut)
		fence_cut.visible = bool(sim.fence_cut)
	if generator_running != null:
		generator_running.visible = not bool(sim.radio_cut)
		generator_dead.visible = bool(sim.radio_cut)
	if barracks_door != null:
		# open from a moment before the men turn out until none of them is left (a restore can take them away)
		var alarm: Dictionary = sim.alarm
		var wanted: bool = bool(alarm.active) and int(alarm.get("reinforce_pending", 0)) > 0 and float(alarm.get("reinforce_in", 9.0)) < 0.8
		for guard: Dictionary in sim.guards:
			if str(guard.kind) == "reinforcement": wanted = true
		door_open_angle = move_toward(door_open_angle, DOOR_OPEN if wanted else 0.0, dt * 5.0)
		barracks_door.basis = Basis(Vector3.UP, door_open_angle * _door_sign) * _door_closed
	_sync_traps()

func _commit(kit: Kit, parent: Node3D, node_name: String, shadows: bool) -> MeshInstance3D:
	triangle_total += kit.triangle_count()
	return kit.commit(parent, materials, node_name, shadows)

## Labels that have a painted sign baked into the trim sheet.
func _baked_signs() -> Dictionary:
	var out: Dictionary = {}
	var path := Kit.TEX_DIR + "trim_labels.json"
	if not FileAccess.file_exists(path):
		return out
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if parsed is Dictionary and parsed.get("labels") is Array:
		var labels: Array = parsed.labels
		for i: int in range(mini(3, labels.size())):
			if str(labels[i]) != "":
				out[str(labels[i])] = "sign%d" % i
	return out

func _building(builder: Buildings, flat: Kit, at: Vector3, dims: Vector3, id: String, label_text: String) -> void:
	var node := Node3D.new()
	node.name = "Building_" + id
	node.position = at
	add_child(node)
	var roof := Node3D.new()
	roof.name = "Roof"
	node.add_child(roof)
	var body := Kit.new()
	var top := Kit.new()
	builder.loose_signs.clear()
	builder.wear.clear()
	builder.hinged.clear()
	match id:
		"radio":
			builder.radio(body, top, dims.x, dims.z, label_text)
			_generator(builder, node, dims)
			_alarm(builder, roof, top, dims)
		"stores": builder.depot(body, top, dims.x, dims.z, label_text)
		_:
			builder.barracks(body, top, dims.x, dims.z, label_text)
			if barracks_door == null and not builder.hinged.is_empty(): _door_leaf(node, builder.hinged[0])
	builder.skirt(flat, at.x, at.z, dims.x, dims.z)
	for mark: Vector3 in builder.wear:
		flat.decal(Kit.DECAL["dirt"], at.x + mark.x, at.z + mark.y, Vector2(mark.z, mark.z * 0.85), rng.randf() * TAU, Color(0.8, 0.76, 0.68, 0.7))
	_commit(body, node, "Body", true)
	_commit(top, roof, "RoofMesh", true)
	# Labels that are not baked into the trim sheet fall back to live text on the blank board.
	for entry: Dictionary in builder.loose_signs:
		var text := Label3D.new()
		text.auto_translate_mode = Node.AUTO_TRANSLATE_MODE_DISABLED  # signage in the world: never translated
		text.text = str(entry.text)
		text.font_size = 48
		text.pixel_size = float(entry.width) / (maxf(1.0, float(text.text.length())) * 40.0)
		text.modulate = Color("2b3028")
		text.outline_size = 0
		text.shaded = true
		text.alpha_cut = Label3D.ALPHA_CUT_DISCARD
		text.transform = Transform3D(entry.basis, entry.at)
		node.add_child(text)
	buildings.append({"node": node, "roof": roof, "id": id})

## Called every frame from world.update_visuals (dt is real time; paused = command mode).
func update(dt: float, paused: bool) -> void:
	_sync_rules(dt)
	if alarm_lamp != null:
		# two quick flashes a second while the alarm is on (frozen, lit, in command mode)
		var lit: bool = bool(sim.alarm.active) and (paused or fposmod(_clock * 2.2, 1.0) < 0.55)
		alarm_lamp.visible = lit
		if lit:
			var size := 1.5 + 0.5 * sin(_clock * 13.8)
			_lamp_halo.scale = Vector3(size, size, size)
	if paused or _boat == null:
		return
	_clock += dt
	if generator_running != null and generator_running.visible:
		for i: int in range(_puffs.size()):
			var t := fposmod(_clock * 0.55 + float(i) / float(_puffs.size()), 1.0)
			var puff := _puffs[i]
			puff.position = _puff_from + Vector3(0.10 * t + 0.03 * sin(_clock * 1.7 + float(i) * 2.1), 0.05 + 0.75 * t, -0.16 * t)
			var size := 0.22 + 0.6 * t
			puff.scale = Vector3(size, size, size)
			(puff.material_override as StandardMaterial3D).albedo_color.a = 0.75 * sin(PI * minf(1.0, t * 1.15)) * (1.0 - t * 0.8)
	# gentle bob and roll at the mooring
	_boat.position.y = BOAT_AT.y + sin(_clock * 1.3) * 0.012
	_boat.rotation.z = sin(_clock * 0.9 + 0.7) * 0.022
	_boat.rotation.x = sin(_clock * 0.7) * 0.008
